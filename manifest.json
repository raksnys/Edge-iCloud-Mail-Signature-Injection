{
  "manifest_version": 3,
  "name": "iCloud Mail Format & Signature",
  "version": "1.0.0",
  "description": "Always turns on \"Format message\" in iCloud Mail and adds your HTML signature to new messages.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "iCloud Mail signature settings"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.icloud.com/*"],
      "js": ["src/shared/settings.js", "src/content/format-core.js", "src/content/format-toggle.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www-mail.icloud-sandbox.com/applications/mail2-rte/*"],
      "js": ["src/shared/settings.js", "src/content/signature-core.js", "src/content/signature.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
